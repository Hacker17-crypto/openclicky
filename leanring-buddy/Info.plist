<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<!-- Speech-to-text: "apple" (on-device, default), "assemblyai" or "openai". -->
	<!-- AssemblyAI/OpenAI also need your own key below; otherwise Apple Speech is used. -->
	<key>VoiceTranscriptionProvider</key>
	<string>apple</string>
	<!-- Optional, all blank by default. Keys added here are compiled into YOUR build only. -->
	<!-- Claude itself needs no key: it runs through your local Claude Code login. -->
	<key>AssemblyAIAPIKey</key>
	<string></string>
	<key>OpenAIAPIKey</key>
	<string></string>
	<key>ElevenLabsAPIKey</key>
	<string></string>
	<key>ElevenLabsVoiceID</key>
	<string></string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenClicky uses your microphone so you can talk to it</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>OpenClicky needs screen recording access to see your screen and help you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenClicky uses speech recognition to transcribe your voice when you talk to it</string>
</dict>
</plist>
